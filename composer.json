{
	"name": "indual-web/swiss-parks-php-sdk",
	"description": "PHP SDK that imports Swiss Parks offers into a local SQLite database and renders filter, list, map and detail views",
	"type": "library",
	"keywords": ["swiss-parks", "parks", "sdk", "sqlite", "offers"],
	"homepage": "https://github.com/indual-web/swiss-parks-php-sdk",
	"license": "MIT",
	"authors": [
		{
			"name": "indual",
			"homepage": "https://www.indual.ch"
		}
	],
	"support": {
		"docs": "https://github.com/indual-web/swiss-parks-php-sdk/tree/main/docs",
		"issues": "https://github.com/indual-web/swiss-parks-php-sdk/issues",
		"source": "https://github.com/indual-web/swiss-parks-php-sdk"
	},
	"require": {
		"php": ">=8.2 <8.6",
		"ext-curl": "*",
		"ext-mbstring": "*",
		"ext-pdo_sqlite": "*",
		"ext-simplexml": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"SwissParks\\Sdk\\": "swiss-parks-sdk/classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SwissParks\\Sdk\\Tests\\": "tests/"
		}
	},
	"bin": [
		"swiss-parks-sdk/bin/swiss-parks-sdk"
	],
	"scripts": {
		"test": "phpunit"
	}
}
