#!/usr/bin/env php
<?php
/*
| Swiss Parks PHP SDK
| https://github.com/indual-web/swiss-parks-php-sdk
|
| Built by indual · www.indual.ch
|
| CLI entry for Composer installations (vendor/bin/swiss-parks-sdk)
|
| Usage:
|   swiss-parks-sdk migrate [--if-outdated] [--config=<path>]
|   swiss-parks-sdk sync [--force] [--config=<path>]
|
*/
$commands = [
	'migrate' => __DIR__ . '/migrate.php',
	'sync' => __DIR__ . '/sync.php',
];

$command = $argv[1] ?? '';
if (! isset($commands[$command])) {
	fwrite(STDERR, 'Usage: swiss-parks-sdk <migrate|sync> [--if-outdated] [--force] [--config=<path>]' . PHP_EOL);
	exit(1);
}

// The scripts read their options from $argv
array_splice($argv, 1, 1);
require $commands[$command];
